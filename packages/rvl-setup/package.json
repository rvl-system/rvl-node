{
  "name": "rvl-setup",
  "version": "1.0.0",
  "description": "Configures the boards on an RVL network from the browser",
  "type": "module",
  "private": true,
  "exports": {
    "./server": "./src/server/index.ts",
    "./client": "./src/client/index.ts"
  },
  "scripts": {
    "build": "vite build",
    "start": "node src/server/bin.ts",
    "typecheck": "tsc && tsc -p src/client && tsc -p test",
    "test": "vitest run",
    "lint": "eslint --report-unused-disable-directives \"**/*.{ts,tsx,mts,js,jsx,mjs}\"",
    "dev": "node --watch src/server/bin.ts --dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rvl-system/rvl-js.git",
    "directory": "packages/rvl-setup"
  },
  "author": "Bryan Hughes <bryan@nebri.us>",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/rvl-system/rvl-js/issues"
  },
  "homepage": "https://github.com/rvl-system/rvl-js/tree/main/packages/rvl-setup#readme",
  "dependencies": {
    "@fastify/static": "^10.1.8",
    "@fastify/websocket": "^11.3.6",
    "fastify": "^5.12.8",
    "rvl-node": "*"
  },
  "devDependencies": {
    "@fastify/middie": "^9.3.6",
    "@mantine/core": "^9.7.4",
    "@mantine/hooks": "^9.7.4",
    "@tabler/icons-react": "^3.50.0",
    "@types/connect": "^3.4.38",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "jotai": "^3.0.1",
    "jotai-family": "^1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
