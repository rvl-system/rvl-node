{
  "name": "rvl-setup",
  "version": "0.1.0",
  "description": "Configures the boards on an RVL network from the browser",
  "type": "module",
  "bin": {
    "rvl-setup": "dist/server/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc && vite build",
    "typecheck": "tsc --noEmit && tsc -p src/client",
    "lint": "eslint --report-unused-disable-directives \"**/*.{ts,tsx,mts,js,jsx,mjs}\"",
    "dev:server": "node --watch src/server/bin.ts --no-open",
    "dev:client": "vite"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rvl-system/rvl-setup.git"
  },
  "author": "Bryan Hughes <bryan@nebri.us>",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/rvl-system/rvl-setup/issues"
  },
  "homepage": "https://github.com/rvl-system/rvl-setup#readme",
  "dependencies": {
    "@fastify/static": "10.1.7",
    "fastify": "5.12.7"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "@mantine/core": "9.7.3",
    "@mantine/hooks": "9.7.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.13.0",
    "import-integrity-lint": "1.3.1",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5"
  }
}
